# -----------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copia este archivo como ".env" y rellena tus credenciales reales.
# El archivo ".env" NUNCA se sube al repositorio (ver .gitignore).
# -----------------------------------------------------------------------------
# --- PostgreSQL (base de datos transaccional) --------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ventas_ia_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
# --- MongoDB Atlas (metadatos de modelos) -----------------------------------
# Cadena de conexion que entrega Atlas en "Connect" > "Drivers".
MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ml_metadata